# Salin file ini menjadi ".env" (tanpa .example) lalu isi dengan nilai asli Anda.
# File ".env" TIDAK ikut ter-upload ke GitHub/GitLab (sudah didaftarkan di .gitignore).

POSTGRES_USER=garasi
POSTGRES_PASSWORD=ganti-dengan-password-yang-kuat
POSTGRES_DB=garasi_java_mobilindo

# Kunci rahasia untuk sesi login. Ganti dengan teks acak yang panjang & unik.
# Bisa generate teks acak lewat: https://www.uuidgenerator.net/ (pakai beberapa digabung)
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang-dan-unik
